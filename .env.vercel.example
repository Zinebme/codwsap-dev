###############################################################################
# CODWSAP — variables d'environnement VERCEL (+ Supabase)
#
# Copiez chaque variable dans Vercel → Project → Settings → Environment
# Variables. NE COMMITEZ JAMAIS les valeurs réelles.
#
# Toutes les valeurs ci-dessous sont des ESPACES RÉSERVÉS.
# Générer un secret :  openssl rand -hex 32
###############################################################################

# ─────────────────────────────────────────────────────────────────────────────
# 1. ENVIRONNEMENT
# ─────────────────────────────────────────────────────────────────────────────
# NODE_ENV est fourni automatiquement par Vercel : ne le définissez PAS.
# PORT est géré par Vercel : ne le définissez PAS.

# Distingue staging de production. Bloque aussi le seed (voir scripts/seed.ts).
APP_ENV=staging

# ─────────────────────────────────────────────────────────────────────────────
# 2. BASE DE DONNÉES SUPABASE — DEUX URL DISTINCTES
# ─────────────────────────────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string
#
#   DATABASE_URL           = « Transaction pooler »  (port 6543)  → RUNTIME
#   MIGRATION_DATABASE_URL = « Direct connection »   (port 5432)  → MIGRATIONS
#
# Pourquoi deux URL :
#   - Le runtime Vercel est serverless : des centaines de fonctions éphémères
#     ouvrent des connexions. Seul le pooler transactionnel (6543) tient la
#     charge ; la connexion directe serait saturée immédiatement.
#   - Les migrations utilisent des verrous consultatifs qui doivent survivre
#     entre plusieurs requêtes : cela exige une connexion SESSION (5432).
#     Le mode transaction ne le garantit pas.
#
# IMPORTANT : conservez ?sslmode=require et ?pgbouncer=true fournis par Supabase.

# Runtime (pooler transactionnel, port 6543) :
DATABASE_URL=postgresql://postgres.<ref>:<MOT_DE_PASSE>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require

# Migrations uniquement (connexion directe, port 5432).
# À définir en LOCAL de préférence ; inutile côté Vercel si vous migrez depuis
# votre machine (recommandé — voir docs/DEPLOYMENT_VERCEL_SUPABASE.md).
MIGRATION_DATABASE_URL=postgresql://postgres.<ref>:<MOT_DE_PASSE>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

DB_DRIVER=postgres
PGSSL=require

# Connexions par instance de fonction. En serverless, le code force déjà 1 par
# défaut : ne l'augmentez pas sans raison, le pooler Supabase mutualise déjà.
# PGPOOL_MAX=1

# ─────────────────────────────────────────────────────────────────────────────
# 3. SECRETS — OBLIGATOIRES, UNIQUES PAR ENVIRONNEMENT
# ─────────────────────────────────────────────────────────────────────────────
# Chiffre au repos les identifiants marchands (jetons WhatsApp Cloud API, clés
# API transporteurs, identifiants Google, secrets webhooks).
# PERTE = identifiants irrécupérables. Ne réutilisez jamais la clé de production.
CREDENTIALS_KEY=

# Signe les cookies de session (JWT). Le changer déconnecte tous les usagers.
SESSION_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# 3 bis. SUPABASE AUTH — identité des marchands
# ─────────────────────────────────────────────────────────────────────────────
# Supabase Auth gère UNIQUEMENT l'identité : mot de passe, vérification email,
# réinitialisation, OAuth Google/Apple. La base CODWSAP reste la source de
# vérité pour les marchands, les rôles OWNER/ADMIN/AGENT et les abonnements.
#
# Ces deux variables sont exposées au navigateur (préfixe NEXT_PUBLIC_) : c'est
# prévu et sans danger, la clé publiable n'ouvre aucun accès sans les
# politiques RLS.
#
# Tableau de bord Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ATTENTION : ne définissez JAMAIS la clé `service_role` ici ni ailleurs dans ce
# projet. Elle contourne la RLS ; exposée côté navigateur, elle donnerait accès
# à toutes les données de tous les marchands. Aucun code de cette application
# ne la lit.
#
# Si ces variables sont absentes, l'application continue de fonctionner avec
# l'authentification locale par email/mot de passe : rien n'est cassé, mais
# Google/Apple et les emails de vérification sont indisponibles.

# ─────────────────────────────────────────────────────────────────────────────
# 4. TÂCHES PLANIFIÉES — OBLIGATOIRE
# ─────────────────────────────────────────────────────────────────────────────
# Protège /api/cron. SANS cette variable, /api/cron renvoie 503 et AUCUNE tâche
# de fond ne s'exécute (refus par défaut : l'endpoint n'est jamais ouvert).
#
# Utilisé à la fois par Vercel Cron (en-tête injecté automatiquement) et par
# Supabase Cron (en-tête à fournir manuellement dans l'appel pg_net).
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# 5. INTÉGRATIONS
# ─────────────────────────────────────────────────────────────────────────────
# App Secret Meta : valide la signature X-Hub-Signature-256 des webhooks
# WhatsApp. Sans lui, les webhooks entrants sont refusés.
# Les jetons WhatsApp PAR MARCHAND ne sont pas ici : ils sont saisis dans
# l'interface et chiffrés en base avec CREDENTIALS_KEY.
META_APP_SECRET=

###############################################################################
# NE PAS DÉFINIR SUR VERCEL
#
#   DATABASE_FILE      SQLite, développement local uniquement
#   ALLOW_SEED         n'activez jamais le seed en staging/production
#   SEED_*             aucune donnée de démonstration en environnement public
#   WORKER_*           il n'y a plus de worker permanent : /api/cron le remplace
#   REDIS_URL          non utilisé — la file d'attente est dans PostgreSQL
###############################################################################
