{
  "name": "codwsap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000} -H 0.0.0.0",
    "worker": "tsx --conditions=react-server scripts/worker.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:gen-schema": "tsx scripts/gen-pg-schema.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "pg:start": "tsx scripts/pg-local.ts start",
    "seed": "tsx --conditions=react-server scripts/seed.ts",
    "test:isolation": "tsx --conditions=react-server scripts/run-isolation-suite.ts",
    "verify": "npm run typecheck && npm run lint && npm run build",
    "admin:create": "tsx --conditions=react-server scripts/create-admin.ts",
    "test:delivery": "tsx --conditions=react-server scripts/test-delivery-connectors.ts",
    "test:auth": "tsx --conditions=react-server scripts/test-auth.ts",
    "test:team": "tsx --conditions=react-server scripts/test-team.ts",
    "test:admin-ops": "tsx --conditions=react-server scripts/test-admin-ops.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.42.0",
    "next": "15.5.25",
    "pg": "^8.23.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.13",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
