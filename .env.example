# Clés de chiffrement — générer avec: openssl rand -hex 32
CREDENTIALS_KEY=
SESSION_SECRET=

# Signature des webhooks Meta (App Secret de votre application Meta)
META_APP_SECRET=

# Jeton attendu par /api/cron (Bearer)
CRON_SECRET=
